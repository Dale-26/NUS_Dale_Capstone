{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.1.0/schema.json",
  "name": "weather",
  "position": {
    "x": 490,
    "y": 460,
    "z": 0,
    "width": 450,
    "height": 300
  },
  "visual": {
    "visualType": "clusteredBarChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Traffic"
                    }
                  },
                  "Property": "weather_main"
                }
              },
              "queryRef": "Traffic.weather_main"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Traffic"
                    }
                  },
                  "Property": "Average Traffic"
                }
              },
              "queryRef": "Traffic.Average Traffic"
            }
          ]
        }
      }
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Average traffic by weather'"
                }
              }
            }
          }
        }
      ]
    }
  }
}